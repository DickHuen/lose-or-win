# btcperp secrets. install.py copies this to .env once; open .env with Notepad and fill it in.
# NEVER put the main wallet private key here. Only the Polymarket Perps PROXY signer.
# Never paste these values into chat, email, screenshots or anywhere else.

# Proxy signer private key (0x + 64 hex) returned when the proxy was created.
PM_PROXY_PRIVATE_KEY=
# Proxy API secret returned by POST /v1/account/proxy (authenticates private reads).
PM_PROXY_SECRET=
# Your main wallet ADDRESS (public address only, never its key). Used to verify the proxy's owner.
PM_WALLET_ADDRESS=
# Optional: proxy expiry (ISO-8601, UTC). The bot reads the real expiry from the API; this is a fallback.
PM_PROXY_EXPIRES_AT=

# Alerts are shown on the dashboard and as Windows notifications; Telegram is not used.
